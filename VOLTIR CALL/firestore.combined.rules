rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---------- KIDS (كما كانت) ----------
    match /users/{uid} {
      allow read, write: if owns(uid);
      match /{document=**} {
        allow read, write: if owns(uid);
      }
    }

    // ---------- VOLTIR CALL ----------
    match /volti_users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /volti_chats/{chatId} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;

      match /messages/{msgId} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/volti_chats/$(chatId)).data.members;
        allow create: if signedIn() && request.resource.data.sender == request.auth.uid;
        allow update: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/volti_chats/$(chatId)).data.members;
        allow delete: if false;
      }
    }

    match /volti_calls/{callId} {
      allow read: if signedIn() &&
        (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if signedIn() && request.auth.uid == request.resource.data.from;
      allow update: if signedIn() &&
        (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);

      match /callerCandidates/{candId} {
        allow read, create: if signedIn() &&
          (request.auth.uid == get(/databases/$(database)/documents/volti_calls/$(callId)).data.from ||
           request.auth.uid == get(/databases/$(database)/documents/volti_calls/$(callId)).data.to);
      }

      match /calleeCandidates/{candId} {
        allow read, create: if signedIn() &&
          (request.auth.uid == get(/databases/$(database)/documents/volti_calls/$(callId)).data.from ||
           request.auth.uid == get(/databases/$(database)/documents/volti_calls/$(callId)).data.to);
      }
    }

    match /volti_status/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /volti_communities/{communityId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if false;
    }

    // الباقي مغلق
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
